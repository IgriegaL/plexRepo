# Copia este archivo a .env (o ejecuta ./scripts/setup.sh, que lo hace por ti
# y completa PUID/PGID y ADMIN_PASSWORD automáticamente).

# ---------------------- Usuarios y zona horaria ----------------------
# Obtén tu PUID y PGID ejecutando: id -u y id -g
PUID=1000
PGID=1000
TZ=America/Santiago

# ---------------------- Credenciales comunes ----------------------
# Se usan para qBittorrent, Sonarr, Radarr y Prowlarr (login de la web).
# Si lo dejas vacío, setup.sh genera una contraseña aleatoria.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---------------------- Plex Claim Token ----------------------
# Solo se necesita en el PRIMER arranque. Obtén uno en https://www.plex.tv/claim/
# (expira en 4 minutos: setup.sh te lo pide justo antes de levantar Plex)
PLEX_CLAIM=

# ---------------------- Auto-configuración (bootstrap) ----------------------
# Perfil de calidad por defecto para Overseerr (si no existe, usa el primero)
QUALITY_PROFILE=HD-1080p
# Idioma de metadatos de las bibliotecas de Plex creadas automáticamente
PLEX_LANGUAGE=es-ES

# ---------------------- Configuraciones en NVMe ----------------------
# Almacenamiento rápido para configuraciones de aplicaciones (ajusta rutas si hace falta)
PLEX_CONFIG_VOLUME=/mnt/nvme/docker-volumes/plex
SONARR_CONFIG_VOLUME=/mnt/nvme/docker-volumes/sonarr
RADARR_CONFIG_VOLUME=/mnt/nvme/docker-volumes/radarr
BAZARR_CONFIG_VOLUME=/mnt/nvme/docker-volumes/bazarr
PROWLARR_CONFIG_VOLUME=/mnt/nvme/docker-volumes/prowlarr
OVERSEERR_CONFIG_VOLUME=/mnt/nvme/docker-volumes/overseerr
QBITTORRENT_CONFIG_VOLUME=/mnt/nvme/docker-volumes/qbittorrent
TAUTULLI_CONFIG_VOLUME=/mnt/nvme/docker-volumes/tautulli
REQUESTRR_CONFIG_VOLUME=/mnt/nvme/docker-volumes/requestrr
PORTAINER_CONFIG_VOLUME=/mnt/nvme/docker-volumes/portainer

# ---------------------- Medios en DiscoDuro ----------------------
# Almacenamiento de alta capacidad para contenido multimedia
TV_SERIES_VOLUME=/mnt/DiscoDuro/tvserie
MOVIES_VOLUME=/mnt/DiscoDuro/movies
DOWNLOADS_VOLUME=/mnt/DiscoDuro/downloads

# ---------------------- Opcional ----------------------
# Token para vincular Netdata Cloud (https://app.netdata.cloud)
NETDATA_CLAIM_TOKEN=
